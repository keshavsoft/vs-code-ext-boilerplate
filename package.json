{
  "name": "vs-code-ext-boilerplate",
  "displayName": "ks-express-boilerplate",
  "description": "express boilerplate",
  "publisher": "KeshavSoft",
  "type": "module",
  "version": "1.10.3",
  "homepage": "https://marketplace.visualstudio.com/items?itemName=KeshavSoft.vs-code-ext-boilerplate",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/keshavsoft/vs-code-ext-boilerplate.git"
  },
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.simple",
        "title": "Express BoilerPlate with simple"
      },
      {
        "command": "extension.simpleWithCrud",
        "title": "Express BoilerPlate with simple crud functionality"
      },
      {
        "command": "extension.showHtml",
        "title": "Express BoilerPlate Templates"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "extension.simple",
          "when": "explorerResourceIsFolder",
          "group": "navigation@1"
        },
        {
          "command": "extension.simpleWithCrud",
          "when": "explorerResourceIsFolder",
          "group": "navigation@1"
        },
        {
          "command": "extension.showHtml",
          "when": "explorerResourceIsFolder",
          "group": "navigation@1"
        }
      ],
      "editor/context": [],
      "editor/title": []
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3"
  },
  "dependencies": {
    "@keshavsoft-org/express-todo": "^1.12.13"
  }
}
